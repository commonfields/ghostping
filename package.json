{
  "name": "openrecord-hosted",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @openrecord/db migrate",
    "db:seed": "pnpm --filter @openrecord/db seed",
    "db:seed:demo": "pnpm --filter @openrecord/worker exec tsx ../../scripts/demo-seed.ts",
    "dev": "echo 'run: pnpm --filter @openrecord/api dev | pnpm --filter @openrecord/worker dev | pnpm --filter @openrecord/web dev (see docs)'",
    "provider:live:9router": "bash scripts/live-9router-check.sh"
  },
  "devDependencies": {
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript-eslint": "8.46.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
